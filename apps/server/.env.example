# Optional. The server defaults to 2567.
PORT=2567

# Required for persistent stats and coin rewards in production.
# The public URL also falls back to VITE_SUPABASE_URL in shared environments.
SUPABASE_URL=https://your-project.supabase.co
# Keep the key server-only; never prefix it with VITE_ or expose it to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-server-only-service-role-key
