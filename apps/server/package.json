{
  "name": "@but/server",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/index.ts",
    "build": "tsc --noEmit",
    "start": "tsx --env-file-if-exists=.env src/index.ts",
    "smoke": "tsx --env-file-if-exists=.env --test test/foundation.test.ts",
    "test": "tsx --test --test-timeout=30000 test/blackjack-rules.test.ts test/blackjack-party.test.ts test/poker-rules.test.ts test/poker-party.test.ts test/bomb-party.test.ts test/game-rules.test.ts test/tank-arena.test.ts test/tank-rules.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@but/blackjack-party": "workspace:*",
    "@but/poker-party": "workspace:*",
    "@but/bomb-party": "workspace:*",
    "@but/shared": "workspace:*",
    "@supabase/supabase-js": "2.116.0",
    "@colyseus/core": "0.18.14",
    "@colyseus/schema": "5.0.33",
    "@colyseus/ws-transport": "0.18.2",
    "express": "5.2.1",
    "@but/tank-arena": "workspace:*"
  },
  "devDependencies": {
    "@colyseus/sdk": "0.18.2",
    "tsx": "4.23.13"
  }
}
